# Copy to .env for local runs. In GitHub Actions these are repository secrets instead.
# Everything is optional — a missing key just disables that feature.

# News (free signup at finnhub.io adds article summaries; NewsAPI is only a fallback — free plan is ~24h delayed)
FINNHUB_API_KEY=
NEWS_API_KEY=

# Email via Gmail SMTP (use a Gmail *app password*, same as the LEAPS scanner)
EMAIL_FROM=
EMAIL_APP_PASSWORD=
EMAIL_TO=

# Optional Telegram summary
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
